{
  "crons": [
    {
      "path": "/api/countdown-email",
      "schedule": "0 5 20 10 *"
    }
  ],
  "rewrites": [
    {
      "source": "/registration",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/brochure",
      "destination": "/index.html"
    },
    {
      "source": "/rulebook",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|_next/|_static/|favicon.ico|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
